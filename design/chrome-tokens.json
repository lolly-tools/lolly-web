{
  "$description": "The web shell's chrome scale tokens (plans/172 P4) - the non-colour axes of the app chrome, as a W3C DTCG document so Penpot and Tokens Studio can open and edit them. scripts/gen-chrome-tokens.ts emits the marked block in shells/web/src/styles/tokens.css from this file; tests/chrome-tokens.test.ts fails on drift. Where a token's CSS spelling cannot be expressed in DTCG (a shadow whose colour is a theme variable, a font size that must ride the --a11y-fs multiplier), $extensions['tools.lolly'].css carries the exact emission and $value stays a representative literal so a visual editor still renders something sensible. Colour deliberately stays out of this file until the codegen has proven itself on these axes - see plan 172.",
  "edge": {
    "$description": "edges - the hairline-ring-instead-of-border move (82 audited sites)",
    "default": { "$type": "shadow", "$value": { "color": "#cfd8e3", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px" },
      "$extensions": { "tools.lolly": { "css": "inset 0 0 0 1px hsl(var(--border))" } } },
    "faint": { "$type": "shadow", "$value": { "color": "#0b10211a", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px" },
      "$extensions": { "tools.lolly": { "css": "inset 0 0 0 1px hsl(var(--foreground) / .1)" } } },
    "strong": { "$type": "shadow", "$value": { "color": "#0b10212e", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px" },
      "$extensions": { "tools.lolly": { "css": "inset 0 0 0 1px hsl(var(--foreground) / .18)" } } }
  },
  "shadow": {
    "$description": "elevation - control / raised / floating / drawer / modal",
    "1": { "$type": "shadow", "$value": { "color": "#00000021", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" },
      "$extensions": { "tools.lolly": { "css": "0 1px 3px hsl(0 0% 0% / .13)" } } },
    "2": { "$type": "shadow", "$value": { "color": "#0000002e", "offsetX": "0px", "offsetY": "4px", "blur": "14px", "spread": "0px" },
      "$extensions": { "tools.lolly": { "css": "0 4px 14px hsl(0 0% 0% / .18)" } } },
    "3": { "$type": "shadow", "$value": { "color": "#00000038", "offsetX": "0px", "offsetY": "8px", "blur": "28px", "spread": "0px" },
      "$extensions": { "tools.lolly": { "css": "0 8px 28px hsl(0 0% 0% / .22)" } } },
    "4": { "$type": "shadow", "$value": { "color": "#00000042", "offsetX": "0px", "offsetY": "12px", "blur": "36px", "spread": "0px" },
      "$extensions": { "tools.lolly": { "css": "0 12px 36px hsl(0 0% 0% / .26)" } } },
    "5": { "$type": "shadow", "$value": { "color": "#00000052", "offsetX": "0px", "offsetY": "24px", "blur": "60px", "spread": "0px" },
      "$extensions": { "tools.lolly": { "css": "0 24px 60px hsl(0 0% 0% / .32)" } } }
  },
  "bevel": {
    "$description": "glass top-light",
    "default": { "$type": "shadow", "$value": { "color": "#ffffff1a", "offsetX": "0px", "offsetY": "1px", "blur": "0px", "spread": "0px" },
      "$extensions": { "tools.lolly": { "css": "inset 0 1px hsl(0 0% 100% / .1)" } } }
  },
  "ring-focus": {
    "$description": "focus rings",
    "default": { "$type": "shadow", "$value": { "color": "#0c322c26", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "3px" },
      "$extensions": { "tools.lolly": { "css": "0 0 0 3px hsl(var(--ring) / .15)" } } },
    "strong": { "$type": "shadow", "$value": { "color": "#0c322c59", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "2px" },
      "$extensions": { "tools.lolly": { "css": "0 0 0 2px hsl(var(--primary) / .35)" } } }
  },
  "radius": {
    "$description": "radius sub-scale - --radius (1rem) stays the card/panel size above this",
    "xs":    { "$type": "dimension", "$value": "3px" },
    "sm":    { "$type": "dimension", "$value": "6px" },
    "md":    { "$type": "dimension", "$value": "10px" },
    "lg":    { "$type": "dimension", "$value": "14px" },
    "pill":  { "$type": "dimension", "$value": "999px" },
    "round": { "$type": "dimension", "$value": "50%",
      "$extensions": { "tools.lolly": { "css": "50%" } } }
  },
  "fs": {
    "$description": "chrome type scale - pre-multiplied by --a11y-fs (the sanctioned home for the largeText multiplier: scaled once, at declaration)",
    "$extensions": { "tools.lolly": { "a11yScale": true } },
    "2xs": { "$type": "dimension", "$value": "10px" },
    "xs":  { "$type": "dimension", "$value": "11px" },
    "sm":  { "$type": "dimension", "$value": "12px" },
    "md":  { "$type": "dimension", "$value": "13px" },
    "lg":  { "$type": "dimension", "$value": "14px" },
    "xl":  { "$type": "dimension", "$value": "16px" }
  },
  "sp": {
    "$description": "space - the 2px grid the gap population already sits on",
    "1": { "$type": "dimension", "$value": "2px" },
    "2": { "$type": "dimension", "$value": "4px" },
    "3": { "$type": "dimension", "$value": "6px" },
    "4": { "$type": "dimension", "$value": "8px" },
    "5": { "$type": "dimension", "$value": "10px" },
    "6": { "$type": "dimension", "$value": "12px" },
    "7": { "$type": "dimension", "$value": "16px" },
    "8": { "$type": "dimension", "$value": "24px" }
  },
  "dur": {
    "$description": "motion",
    "1": { "$type": "duration", "$value": "120ms" },
    "2": { "$type": "duration", "$value": "180ms" },
    "3": { "$type": "duration", "$value": "300ms" }
  },
  "ease": {
    "out":    { "$type": "cubicBezier", "$value": [0.32, 0.72, 0, 1] },
    "spring": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1] }
  },
  "z": {
    "$description": "stacking - names for what were magic numbers (99999/100000)",
    "chrome":  { "$type": "number", "$value": 20 },
    "overlay": { "$type": "number", "$value": 50 },
    "toast":   { "$type": "number", "$value": 90 },
    "max":     { "$type": "number", "$value": 100 }
  }
}
